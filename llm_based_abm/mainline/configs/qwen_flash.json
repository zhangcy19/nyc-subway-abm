{
  "model": "qwen3.8-flash",
  "base_url": "https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
  "api_mode": "chat",
  "key_env": "DASHSCOPE_API_KEY",
  "extra_body": {
    "enable_thinking": false
  },
  "run_id": "qwen38_flash_mainline_run01",
  "token_cap": 15000000,
  "workers": 2,
  "temperature": 0.3,
  "max_output_tokens": 250,
  "batch_max_output_tokens": 700,
  "walking_policy": "zero_walk_renormalize",
  "taxi_policy": "zero_taxi_renormalize"
}